<!-- Title -->
<p style="margin:0 0 8px;font-size:24px;font-weight:700;color:#1a3c6b;font-family:Arial,Helvetica,sans-serif;">
  Reset Your Password
</p>

<!-- Divider -->
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom:24px;">
  <tr>
    <td style="border-bottom:2px solid #1a3c6b;width:48px;">&nbsp;</td>
    <td>&nbsp;</td>
  </tr>
</table>

<!-- Greeting -->
<p style="margin:0 0 16px;font-size:15px;color:#2d3748;font-family:Arial,Helvetica,sans-serif;">
  Hi <strong>{{firstName}}</strong>,
</p>

<!-- Message -->
<p style="margin:0 0 24px;font-size:15px;color:#4a5568;font-family:Arial,Helvetica,sans-serif;line-height:1.75;">
  We received a request to reset the password for your EduSphere account.
  Click the button below to choose a new password.
</p>

<!-- CTA button -->
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom:32px;">
  <tr>
    <td align="center">
      <a
        href="{{resetLink}}"
        target="_blank"
        style="display:inline-block;background-color:#1a3c6b;color:#ffffff;text-decoration:none;padding:14px 40px;border-radius:6px;font-size:15px;font-weight:700;letter-spacing:0.5px;font-family:Arial,Helvetica,sans-serif;"
      >
        Reset Password
      </a>
    </td>
  </tr>
</table>

<!-- Fallback link -->
<p style="margin:0 0 8px;font-size:13px;color:#718096;font-family:Arial,Helvetica,sans-serif;">
  Button not working? Copy and paste this link into your browser:
</p>
<p style="margin:0 0 28px;font-size:13px;font-family:Arial,Helvetica,sans-serif;word-break:break-all;">
  <a href="{{resetLink}}" style="color:#1a3c6b;text-decoration:underline;">{{resetLink}}</a>
</p>

<!-- Warning banner -->
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom:24px;">
  <tr>
    <td style="background-color:#fffbeb;border-left:4px solid #f6ad3e;padding:14px 16px;border-radius:0 4px 4px 0;">
      <p style="margin:0;font-size:13px;color:#7c5e00;font-family:Arial,Helvetica,sans-serif;line-height:1.6;">
        <strong>This link expires in {{expiresIn}}.</strong>
        If you did not request a password reset, you can safely ignore this email.
        Your password will not change until you click the button above.
      </p>
    </td>
  </tr>
</table>

<!-- Security note -->
<p style="margin:0;font-size:12px;color:#a0aec0;font-family:Arial,Helvetica,sans-serif;line-height:1.6;">
  For your security, never share this link with anyone. EduSphere staff will never ask for this link.
</p>
